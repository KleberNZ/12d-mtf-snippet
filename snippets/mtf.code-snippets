  "Abbreviations reference (19.7.13.4)": {
    "prefix": "abb",
    "body": [
      "// INFO Abbreviations used in snippet directives (12d Model 19.7.13.4)",
      "// if        - conditional test",
      "// def       - define a token",
      "// tok       - token",
      "// val       - value",
      "// str       - string (text)",
      "// int       - integer",
      "// dbl       - double",
      "// tol       - tolerance",
      "// eq        - equal",
      "// ne        - not equal",
      "// gt        - greater than",
      "// lt        - less than",
      "// ge        - greater than or equal to",
      "// le        - less than or equal to",
      "// in_range  - within a range of values (lower to upper)",
      "// nin_range - not within a range of values",
      "//",
