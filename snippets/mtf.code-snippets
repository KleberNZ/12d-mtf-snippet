      "//",
      "// Snippet: ${2:Snippet Name}",
      "// Created: ${3:Month Year}",
      "// Updated: ${4:Description of update}",
      "//",
      "// /////////////////////////////////////////////////////////////////",
      "//",
      "// INFO Snippet Type: ${5|INSERT,MODIFY,PAVEMENT,TRIMESH|}",
      "// INFO Description: ${6:Short description}",
      "//",
      "// INFO ${7:Additional info line 1}",
      "// INFO ${8:Additional info line 2}",
      "// INFO ${9:Additional info line 3}",
      "//",
      "// /////////////////////////////////////////////////////////////////",
